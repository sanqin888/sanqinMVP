FROM node:20-alpine AS builder

# 与根 packageManager / CI 保持一致，避免 Docker 构建静默漂移到其他 pnpm 版本。
RUN corepack enable && corepack prepare pnpm@9.0.0 --activate
WORKDIR /app

# 1. 复制依赖定义
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/
COPY libs/foundation/package.json ./libs/foundation/
COPY libs/order/package.json ./libs/order/
COPY libs/shared/package.json ./libs/shared/

# 2. 安装依赖
RUN pnpm install --frozen-lockfile

# 3. 共享库先独立并行构建，纯 Web 源码改动复用这一层。
COPY libs/foundation ./libs/foundation
COPY libs/order ./libs/order
COPY libs/shared ./libs/shared
RUN pnpm --parallel --filter @shared/foundation --filter @shared/menu --filter @shared/order run build

# 4. 最后复制 Web 源码并构建 Next.js Standalone。
# 直接执行 Next，避免 prebuild 再次串行构建已经准备好的共享库。
# 浏览器公开配置由 API 在运行时提供，Web 镜像不再烘焙环境专属 NEXT_PUBLIC_* 值。
# 保留 Next 默认 lint / type checks；这一步生成包含运行代码和依赖的 .next/standalone。
COPY apps/web ./apps/web
ENV NEXT_TELEMETRY_DISABLED=1
RUN pnpm --filter web exec next build --turbopack

# --- 运行阶段 (Runner) ---
FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# [关键修复] 直接复制 Standalone 构建产物
# 这会自动包含 apps/web/server.js 和所有必要的 node_modules (包括 shared libs)
COPY --from=builder /app/apps/web/.next/standalone ./

# [关键修复] 复制静态资源 (Standalone 默认不包含静态图片和 CSS)
COPY --from=builder /app/apps/web/public ./apps/web/public
COPY --from=builder /app/apps/web/.next/static ./apps/web/.next/static

EXPOSE 3000

# [关键修复] 使用 node 直接启动，不再通过 npm start
# 这样规避了 package.json 里强制 8080 端口的问题，直接使用 ENV PORT=3000
CMD ["node", "apps/web/server.js"]
