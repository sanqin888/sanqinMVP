FROM node:20-alpine AS builder
# 与根 packageManager / CI 保持一致，避免 Docker 构建静默漂移到其他 pnpm 版本。
RUN corepack enable && corepack prepare pnpm@9.0.0 --activate
WORKDIR /app

# 1. 复制依赖定义
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/
COPY libs/foundation/package.json ./libs/foundation/
COPY libs/order/package.json ./libs/order/
COPY libs/shared/package.json ./libs/shared/

# 2. 仅安装 API 及其 workspace 依赖；排除 Web 和根 workspace 的无关依赖。
# api... 会包含 API 依赖的三个共享库，仍严格使用同一 frozen lockfile。
RUN pnpm --filter api... install --frozen-lockfile

# 3. 共享库先独立构建：纯 API 源码改动复用这一层，三个无互相依赖的库并行编译。
COPY libs/foundation ./libs/foundation
COPY libs/order ./libs/order
COPY libs/shared ./libs/shared
RUN pnpm --parallel --filter @shared/foundation --filter @shared/menu --filter @shared/order run build

# 4. Prisma 只依赖 schema；纯 API 源码改动不重复生成 builder 的 Client。
COPY apps/api/prisma/schema.prisma ./apps/api/prisma/schema.prisma
RUN pnpm --filter api run prisma:generate

# 5. 最后复制 API 源码，直接执行 Nest；共享库和 Prisma 已由上面的必需步骤准备。
# 不调用 api build 脚本，避免再次串行构建共享库和生成同一个 Prisma Client。
COPY apps/api ./apps/api
# Lightsail 生产 VM 只有约 2 GiB RAM；随着 API 源码增长，Node 20 在容器构建阶段
# 会把默认 old-space 限制在约 1 GiB，Nest/TypeScript 编译可能在到达该限制前 OOM。
# 仅放宽 builder 这一步的 heap；不会传入最终 runner，也不会改变线上 API 运行时内存策略。
RUN NODE_OPTIONS=--max-old-space-size=1536 pnpm --filter api exec nest build

# 6. 生成仅包含 API workspace 依赖的便携运行目录。
# 不使用 --prod，以保留 Prisma CLI / Studio 的现有运行时诊断能力。
RUN pnpm --filter api deploy /app/api-runtime

# deploy 会重组 node_modules；在目标目录内重新生成 Prisma Client，
# 确保 runner 使用的自包含依赖目录拥有与当前 schema 匹配的 client。
RUN cd /app/api-runtime && npx prisma generate --schema=./prisma/schema.prisma

# --- 运行阶段 (Runner) ---
FROM node:20-alpine AS runner
WORKDIR /app

# Accounting attachments use local document extraction so financial evidence
# never leaves the SanQ runtime. Poppler handles PDF text/font mappings while
# Tesseract remains the image-only OCR path.
RUN apk add --no-cache \
    font-noto-cjk \
    poppler-utils \
    tesseract-ocr \
    tesseract-ocr-data-eng \
    tesseract-ocr-data-chi_sim

ENV NODE_ENV=production
ENV PORT=4000

# 复制 pnpm deploy 生成的自包含 API workspace 依赖。
# 不再把 Web 和整个 monorepo 的根 node_modules / libs 复制进运行镜像。
COPY --from=builder /app/api-runtime/node_modules ./apps/api/node_modules

# 复制 API 的构建产物
COPY --from=builder /app/apps/api/dist ./apps/api/dist
COPY --from=builder /app/apps/api/package.json ./apps/api/package.json
COPY --from=builder /app/apps/api/prisma ./apps/api/prisma

# 预热 Prisma Studio 依赖的 query engine，避免运行时首次下载失败
RUN cd /app/apps/api && npx prisma --version

EXPOSE 4000

CMD ["node", "apps/api/dist/main.js"]
