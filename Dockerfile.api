FROM node:20-alpine AS builder
# 启用 pnpm
RUN corepack enable && corepack prepare pnpm@latest --activate
WORKDIR /app

# 1. 复制依赖定义
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/
COPY libs/order/package.json ./libs/order/
COPY libs/shared/package.json ./libs/shared/

# 2. 安装依赖
RUN pnpm install --frozen-lockfile

# 3. 只复制 API 及其共享库源码，避免纯 Web 改动使 API 构建缓存失效
COPY apps/api ./apps/api
COPY libs/order ./libs/order
COPY libs/shared ./libs/shared

# 4. 生成 Prisma Client
WORKDIR /app/apps/api
RUN npx prisma generate

# 5. 构建 API (这会自动触发 libs 的构建，因为 api/package.json 里配了 prebuild 脚本)
WORKDIR /app
RUN pnpm --filter api build

# 6. 生成仅包含 API workspace 依赖的便携运行目录。
# 不使用 --prod，以保留 Prisma CLI / Studio 的现有运行时诊断能力。
RUN pnpm --filter api deploy --legacy /app/api-runtime

# deploy 会重组 node_modules；在目标目录内重新生成 Prisma Client，
# 确保 runner 使用的自包含依赖目录拥有与当前 schema 匹配的 client。
RUN cd /app/api-runtime && npx prisma generate --schema=./prisma/schema.prisma

# --- 运行阶段 (Runner) ---
FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=4000

# 复制 pnpm deploy 生成的自包含 API workspace 依赖。
# 不再把 Web 和整个 monorepo 的根 node_modules / libs 复制进运行镜像。
COPY --from=builder /app/api-runtime/node_modules ./apps/api/node_modules

# 复制 API 的构建产物
COPY --from=builder /app/apps/api/dist ./apps/api/dist
COPY --from=builder /app/apps/api/package.json ./apps/api/package.json
COPY --from=builder /app/apps/api/prisma ./apps/api/prisma

# 预热 Prisma Studio 依赖的 query engine，避免运行时首次下载失败
RUN cd /app/apps/api && npx prisma --version

EXPOSE 4000

CMD ["node", "apps/api/dist/main.js"]
